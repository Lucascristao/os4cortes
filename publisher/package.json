{
  "name": "os4-publicador",
  "version": "0.1.0",
  "private": true,
  "description": "Publicador local integrado ao OS4 Cortes",
  "author": "OS4 Cortes",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --win --x64"
  },
  "build": {
    "appId": "app.os4cortes.publicador",
    "productName": "OS4 Publicador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright*/**/*"
    ],
    "extraResources": [
      {
        "from": "browser",
        "to": "browser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  }
}
